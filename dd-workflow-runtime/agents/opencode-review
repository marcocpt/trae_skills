#!/usr/bin/env python3
"""Thin adapter for opencode-cli backend: OpenCode event stream -> dd-review-result/1.

The Generic Router owns selection/authorization/fallback. This process only:
- validates the approved dd-review-request/1
- invokes `opencode run --agent strong-reviewer-cli --format json` with the
  request as stdin (Router's contract)
- extracts the final assistant text from the NDJSON event stream
- strict-parses that text as review JSON (no markdown, no prose wrapper)
- converts it to a transport dd-review-result/1 object for Router normalization

It never retries, never dispatches a second review, never claims readonly authority.
"""

from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from pathlib import Path
from typing import Any, Dict, List

BACKEND_ID = "opencode-cli"
REQUEST_SCHEMA = "dd-review-request/1"
RESULT_SCHEMA = "dd-review-result/1"
AGENT_NAME = "strong-reviewer-cli"
FINDING_KEYS = ("id", "severity", "classification", "change_risk", "location", "evidence", "required_fix")
SHA_RE = re.compile(r"^[0-9a-fA-F]{7,64}$")


def _blocked_result(request: Dict[str, Any], category: str, detail: str) -> Dict[str, Any]:
    target = {
        "base_sha": request.get("base_sha"),
        "head_sha": request.get("head_sha"),
        "scope": list(request.get("scope", [])),
    }
    return {
        "schema": RESULT_SCHEMA,
        "backend": BACKEND_ID,
        "reviewer": f"{AGENT_NAME}/unknown",
        "target": target,
        "status": "BLOCKED",
        "reviewed": [],
        "unreadable": list(request.get("scope", [])),
        "findings": [],
        "evidence": [detail],
        "failure_category": category,
        "readonly_confirmation": {"confirmed": False, "evidence": None},
        "lifecycle": {"started": True, "completed": False},
    }


def _validate_request(req: Dict[str, Any]) -> str | None:
    if req.get("schema") != REQUEST_SCHEMA:
        return f"request schema must be {REQUEST_SCHEMA}"
    for k in ("role", "host", "repo", "base_sha", "head_sha"):
        if not isinstance(req.get(k), str) or not req[k]:
            return f"request.{k} is required"
    for k in ("base_sha", "head_sha"):
        if not SHA_RE.fullmatch(req[k]):
            return f"request.{k} must be SHA"
    scope = req.get("scope")
    if not isinstance(scope, list) or not scope or not all(isinstance(x, str) and x for x in scope):
        return "request.scope must be non-empty string list"
    # Forbid Router-owned keys from crossing adapter boundary (defense in depth)
    for forbidden in ("native_guard", "external_review", "readonly_evidence"):
        if forbidden in req:
            return f"request.{forbidden} must not be forwarded to adapter"
    # verification is required but we don't enforce its content here; Router already did
    if "verification" not in req:
        return "request.verification is required"
    return None


def _extract_final_text(stdout: str) -> tuple[str | None, str | None]:
    lines = [l for l in stdout.splitlines() if l.strip()]
    if not lines:
        return None, "empty stdout"
    events: List[Dict[str, Any]] = []
    for line in lines:
        try:
            events.append(json.loads(line))
        except json.JSONDecodeError as exc:
            return None, f"malformed event JSON: {exc}"
    texts = [e for e in events if e.get("part", {}).get("type") == "text" and e["part"].get("time", {}).get("end")]
    if not texts:
        return None, "missing final assistant text"
    # Final text is the last completed text part (opencode's final assistant message)
    final = texts[-1]["part"].get("text", "")
    if not isinstance(final, str) or not final.strip():
        return None, "empty final text"
    return final, None


def _strict_json_parse(text: str) -> tuple[Any, str | None]:
    stripped = text.strip()
    # Strict checks: no code fence, no prose wrapper, must be single JSON object
    if "```" in stripped:
        return None, "code fence present"
    if not stripped.startswith("{") or not stripped.endswith("}"):
        return None, "not strict JSON object (must start with { and end with })"
    # Quick check for Markdown escapes that indicate Turndown-like corruption
    # (legacy from mcp-review; keep as strictness signal)
    if re.search(r"\\[_\[\]]", stripped):
        return None, "markdown escapes present"
    try:
        obj = json.loads(stripped)
    except json.JSONDecodeError as exc:
        return None, f"invalid JSON: {exc}"
    if not isinstance(obj, dict):
        return None, "top level must be object"
    return obj, None


def _validate_reviewer_json(obj: Dict[str, Any], scope: List[str]) -> str | None:
    status = obj.get("status")
    if not isinstance(status, str):
        return "status is required"
    ustatus = status.upper()
    if ustatus == "FAIL":
        ustatus = "FINDINGS"
    if ustatus not in ("PASS", "FINDINGS", "BLOCKED"):
        return f"unsupported status {status!r}"
    reviewed = obj.get("reviewed")
    unreadable = obj.get("unreadable")
    if not isinstance(reviewed, list) or not all(isinstance(x, str) for x in reviewed):
        return "reviewed must be string list"
    if not isinstance(unreadable, list) or not all(isinstance(x, str) for x in unreadable):
        return "unreadable must be string list"
    scope_set = set(scope)
    if not set(reviewed).issubset(scope_set) or not set(unreadable).issubset(scope_set):
        return "reviewed/unreadable escapes scope"
    if set(reviewed) & set(unreadable):
        return "reviewed and unreadable must not overlap"
    if ustatus == "PASS" and (unreadable or set(reviewed) != scope_set):
        return "PASS requires complete reviewed scope"
    if ustatus == "FINDINGS" and set(reviewed) | set(unreadable) != scope_set:
        return "FINDINGS must account for complete scope"
    findings = obj.get("findings")
    if not isinstance(findings, list):
        return "findings must be list"
    if ustatus == "FINDINGS" and not findings:
        return "FINDINGS requires at least one finding"
    if ustatus == "PASS" and findings:
        return "PASS cannot contain findings"
    for f in findings:
        if not isinstance(f, dict):
            return "finding must be mapping"
        for k in FINDING_KEYS:
            if not isinstance(f.get(k), str) or not f[k]:
                return f"finding missing required field {k}"
    evidence = obj.get("evidence")
    if not isinstance(evidence, list) or not evidence:
        return "evidence must be non-empty list"
    # failure_category only allowed for BLOCKED
    fc = obj.get("failure_category")
    if ustatus == "BLOCKED":
        # allow null/None for adapter to fill? but reviewer should provide known category if BLOCKED
        if fc is not None and not isinstance(fc, str):
            return "failure_category must be string for BLOCKED"
    else:
        if fc not in (None, "",):
            return "PASS/FINDINGS cannot carry failure_category"
    return None


def main() -> int:
    # CLI contract: opencode-review review  (like mcp-review review)
    if len(sys.argv) != 2 or sys.argv[1] != "review":
        print("usage: opencode-review review", file=sys.stderr)
        return 64
    try:
        raw = sys.stdin.read()
        request = json.loads(raw) if raw.strip() else {}
    except json.JSONDecodeError as exc:
        # No valid request -> cannot build target, emit minimal BLOCKED
        result = {
            "schema": RESULT_SCHEMA,
            "backend": BACKEND_ID,
            "reviewer": AGENT_NAME,
            "target": {"base_sha": None, "head_sha": None, "scope": []},
            "status": "BLOCKED",
            "reviewed": [],
            "unreadable": [],
            "findings": [],
            "evidence": [f"invalid request JSON: {exc}"],
            "failure_category": "schema_invalid",
            "readonly_confirmation": {"confirmed": False, "evidence": None},
            "lifecycle": {"started": False, "completed": False},
        }
        print(json.dumps(result, ensure_ascii=False))
        return 0
    if not isinstance(request, dict):
        result = _blocked_result({}, "schema_invalid", "request must be object")
        print(json.dumps(result, ensure_ascii=False))
        return 0

    err = _validate_request(request)
    if err:
        result = _blocked_result(request, "schema_invalid", err)
        print(json.dumps(result, ensure_ascii=False))
        return 0

    # Verify frozen baseline minimally (repo exists, HEAD matches, no dirty)
    # We do lightweight checks; full verification is Router's job, but adapter should fail-closed on dirty worktree
    repo = Path(request["repo"])
    try:
        head = subprocess.run(["git", "-C", str(repo), "rev-parse", "HEAD"], capture_output=True, text=True, timeout=10).stdout.strip()
        if head != request["head_sha"]:
            result = _blocked_result(request, "baseline_mismatch", "HEAD differs from head_sha")
            print(json.dumps(result, ensure_ascii=False))
            return 0
        dirty = subprocess.run(["git", "-C", str(repo), "status", "--porcelain=v1", "--untracked-files=all"], capture_output=True, text=True, timeout=10).stdout.strip()
        if dirty:
            result = _blocked_result(request, "baseline_mismatch", "worktree dirty")
            print(json.dumps(result, ensure_ascii=False))
            return 0
    except Exception as exc:
        result = _blocked_result(request, "evidence_mismatch", f"git check failed: {exc}")
        print(json.dumps(result, ensure_ascii=False))
        return 0

    # Invoke opencode CLI
    cmd = ["opencode", "run", "--agent", AGENT_NAME, "--format", "json"]
    env = {"PATH": os.environ.get("PATH", ""), "HOME": os.environ.get("HOME", str(Path.home()))}
    try:
        completed = subprocess.run(
            cmd,
            input=json.dumps(request, ensure_ascii=False),
            capture_output=True,
            text=True,
            timeout=600,
            cwd=request["repo"],
            env=env,
        )
    except FileNotFoundError:
        # Treat as availability - let Router fallback if policy allows
        sys.stderr.write("opencode executable not found\n")
        return 69
    except subprocess.TimeoutExpired:
        sys.stderr.write("opencode timed out\n")
        return 75

    if completed.returncode != 0:
        # Classify via registry's availability/transient codes
        if completed.returncode == 69:
            return 69
        if completed.returncode == 75:
            return 75
        # Other non-zero -> backend_execution_failed as BLOCKED
        result = _blocked_result(request, "backend_execution_failed", f"opencode exit {completed.returncode}: {completed.stderr[:500]}")
        print(json.dumps(result, ensure_ascii=False))
        return 0

    # stdout is NDJSON event stream - ensure stderr didn't leak into stdout parsing
    # (stderr is separate capture, so safe)

    final_text, err = _extract_final_text(completed.stdout)
    if err:
        result = _blocked_result(request, "review_incomplete" if "missing" in err else "schema_invalid", err)
        print(json.dumps(result, ensure_ascii=False))
        return 0

    obj, err = _strict_json_parse(final_text)
    if err:
        result = _blocked_result(request, "schema_invalid", err)
        print(json.dumps(result, ensure_ascii=False))
        return 0

    err = _validate_reviewer_json(obj, request["scope"])
    if err:
        result = _blocked_result(request, "schema_invalid", err)
        print(json.dumps(result, ensure_ascii=False))
        return 0

    # Build transport result for Router
    status = obj["status"].upper()
    if status == "FAIL":
        status = "FINDINGS"
    # Normalize findings via required keys only
    findings = []
    for f in obj.get("findings", []):
        findings.append({k: f[k] for k in FINDING_KEYS})

    result = {
        "schema": RESULT_SCHEMA,
        "backend": BACKEND_ID,
        "reviewer": f"{AGENT_NAME}/muse-spark-1.2-contributor-free",
        "target": {
            "base_sha": request["base_sha"],
            "head_sha": request["head_sha"],
            "scope": list(request["scope"]),
        },
        "status": status,
        "reviewed": list(obj["reviewed"]),
        "unreadable": list(obj["unreadable"]),
        "findings": findings,
        "evidence": list(obj["evidence"]),
        "failure_category": obj.get("failure_category") if status == "BLOCKED" else None,
        "readonly_confirmation": {"confirmed": False, "evidence": None},
        "lifecycle": {"started": True, "completed": status in ("PASS", "FINDINGS")},
    }
    print(json.dumps(result, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
